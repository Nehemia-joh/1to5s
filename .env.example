# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign session cookies (openssl rand -base64 32)
SESSION_SECRET="change-me"

# Comma-separated bootstrap admins, format: "Name <email>" or bare "email"
ADMIN_EMAILS="Admin Name <admin@example.com>"

# Shared secret Vercel Cron sends as a Bearer token to /api/cron/*
CRON_SECRET="change-me"
